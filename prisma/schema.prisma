
// Acta data model, version 1.
// Business rules that Prisma cannot express are enforced by SQL migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model OrgUnit {
  id        String  @id @default(uuid())
  parentId  String?
  name      String  @db.VarChar(150)
  type      String  @db.VarChar(50)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  requiresApproval Boolean @default(false)
  autoFlowsUp      Boolean @default(true)
  attentionGroupId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children OrgUnit[] @relation("OrgUnitTree")

  users              User[]
  authoredActivities Activity[]           @relation("ActivityAuthorUnit")
  targetedActivities ActivityTargetDept[]
  workCalendar       OrgUnitWorkCalendar?

  @@index([parentId])
  @@index([isActive])
}

model User {
  id        String  @id @default(uuid())
  fullName  String  @db.VarChar(150)
  title     String? @db.VarChar(100)
  email     String  @unique @db.VarChar(255)
  orgUnitId String

  isUnitManager Boolean @default(false)
  isSystemAdmin Boolean @default(false)
  canViewReports Boolean @default(false)
  canViewScoreReports Boolean @default(false)
  isRoot       Boolean @default(false)
  isScored      Boolean @default(true)

  canAppreciate Boolean @default(false)

  avatarExtension String? @db.VarChar(8)

  notificationMode NotificationMode @default(INSTANT)
  writesActivities Boolean          @default(true)
  isActive         Boolean          @default(true)
  lastLoginAt      DateTime?        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orgUnit    OrgUnit         @relation(fields: [orgUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  credential UserCredential?
  sessions   Session[]

  activities                 Activity[]             @relation("ActivityAuthor")
  drafts                     ActivityDraft[]
  draftAttachments            ActivityDraftAttachment[] @relation("ActivityDraftAttachmentUploader")
  approvals                  Activity[]             @relation("ActivityApprover")
  approvalRounds             ApprovalRound[]        @relation("ApprovalRoundDecider")
  eligibleApprovals          ActivityApprover[]
  activityRevisions          ActivityRevision[]
  cancellations              CancellationRecord[]
  attachments                Attachment[]
  askedConversations         Conversation[]         @relation("ConversationAsker")
  ownedConversations         Conversation[]         @relation("ConversationResponsible")
  closedConversations        Conversation[]         @relation("ConversationCloser")
  conversationMessages       ConversationMessage[]
  readReceipts               ReadReceipt[]
  noActivityPeriods          NoActivityPeriod[]     @relation("NoActivityPeriodUser")
  deputyForPeriods           NoActivityPeriod[]     @relation("NoActivityPeriodDeputy")
  markedNoActivityPeriods    NoActivityPeriod[]     @relation("NoActivityPeriodMarker")
  cancelledNoActivityPeriods NoActivityPeriod[]     @relation("NoActivityPeriodCanceller")
  decidedNoActivityPeriods   NoActivityPeriod[]     @relation("NoActivityPeriodDecider")
  notifications              NotificationQueue[]
  pushSubscriptions          PushSubscription[]
  followUpsOpened            FollowUpItem[]         @relation("FollowUpOpener")
  followUpsOwned             FollowUpItem[]         @relation("FollowUpOwner")
  followUpsClosed            FollowUpItem[]         @relation("FollowUpCloser")
  followUpEvents             FollowUpItemEvent[]
  scorePeriods               UserScorePeriod[]
  appreciations              ActivityAppreciation[]
  auditLogs                  AuditLog[]             @relation("AuditLogUser")
  auditLogsAsActual          AuditLog[]             @relation("AuditLogActualUser")
  backupRequests              BackupRequest[]        @relation("BackupRequestRequester")
  systemResetRequests        SystemResetRequest[]   @relation("SystemResetRequester")
  helpArticlesCreated        HelpArticle[]          @relation("HelpArticleCreator")
  helpArticlesUpdated        HelpArticle[]          @relation("HelpArticleUpdater")
  feedbackSubmitted          Feedback[]             @relation("FeedbackSubmitter")
  feedbackRead               Feedback[]             @relation("FeedbackReader")
  feedbackReviewed           Feedback[]             @relation("FeedbackReviewer")
  feedbackResolved           Feedback[]             @relation("FeedbackResolver")

  @@index([orgUnitId])
  @@index([isActive])

  deletionRequests ActivityDeletionRequest[] @relation("DeletionRequester")
}

model UserCredential {
  userId            String    @id
  passwordHash      String
  passwordChangedAt DateTime  @default(now()) @db.Timestamptz(3)
  mustChangePassword Boolean @default(false)
  version           Int       @default(0)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  credentialVersion Int       @default(0)
  revokedAt         DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}


enum ActivityApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  MANAGER_NOT_FOUND
  REJECTED
  CANCELLED
}

enum ApprovalReasonKind {
  CHANGES_REQUESTED
  REJECTED
}

model ApprovalReason {
  id        String             @id @default(uuid())
  kind      ApprovalReasonKind
  label     String             @db.VarChar(120)
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  activities Activity[]

  @@unique([id, kind])
  @@unique([kind, label])
  @@index([kind, isActive, sortOrder])
}

model Activity {
  id              String   @id @default(uuid())
  authorId        String
  authorOrgUnitId String
  activityDate    DateTime @db.Date
  title           String   @db.VarChar(150)
  description     String   @db.VarChar(10000)

  activityNo Int @unique @default(dbgenerated("nextval('activity_no_seq')"))

  approvalStatus    ActivityApprovalStatus @default(APPROVED)
  currentRevisionNo Int                    @default(1)

  approverId          String?
  approvalSubmittedAt DateTime?           @db.Timestamptz(3)
  approvalDecidedAt   DateTime?           @db.Timestamptz(3)
  approvalReasonId    String?
  approvalReasonKind  ApprovalReasonKind?
  approvalReasonNote  String?             @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  author         User            @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver       User?           @relation("ActivityApprover", fields: [approverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvalReason ApprovalReason? @relation(fields: [approvalReasonId, approvalReasonKind], references: [id, kind], onDelete: Restrict, onUpdate: Restrict)
  authorOrgUnit  OrgUnit         @relation("ActivityAuthorUnit", fields: [authorOrgUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  scoreFacts        UserScorePeriodFact[]
  revisions         ActivityRevision[]
  eligibleApprovers ActivityApprover[]
  followUps         FollowUpItem[]
  targetDepts       ActivityTargetDept[]
  attachments       Attachment[]
  cancellation      CancellationRecord?
  conversations     Conversation[]
  readReceipts      ReadReceipt[]
  appreciations     ActivityAppreciation[]
  notifications     NotificationQueue[]

  approvalRounds ApprovalRound[]

  @@index([authorOrgUnitId, activityDate])
  @@index([approvalStatus, activityDate])
  @@index([approverId, approvalStatus])
  @@index([authorId, activityDate])
}

model ApprovalRound {
  id         String @id @default(uuid())
  activityId String
  roundNo    Int

  submittedAt DateTime                @db.Timestamptz(3)
  decidedAt   DateTime?               @db.Timestamptz(3)
  decidedById String?
  decision    ActivityApprovalStatus?

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy User?    @relation("ApprovalRoundDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([activityId, roundNo])
  @@index([decidedById, decidedAt])
}

model ActivityDraft {
  id       String @id @default(uuid())
  authorId String

  activityDate     DateTime @db.Date
  title            String   @db.VarChar(150)
  description      String   @db.VarChar(10000)
  targetOrgUnitIds String[]
  openFollowUp     Boolean  @default(false)

  savedManually Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments ActivityDraftAttachment[]

  @@index([authorId, updatedAt])
}

model ActivityDraftAttachment {
  id           String   @id @default(uuid())
  draftId      String
  originalName String   @db.VarChar(255)
  storedName   String   @unique @db.VarChar(255)
  storagePath  String   @db.VarChar(500)
  sizeBytes    Int
  mimeType     String   @db.VarChar(150)
  sha256       String   @db.Char(64)
  uploadedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  draft      ActivityDraft @relation(fields: [draftId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User          @relation("ActivityDraftAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([draftId, sha256, originalName])
  @@index([draftId, createdAt])
  @@index([sha256])
}

model ActivityApprover {
  activityId String
  userId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([activityId, userId])
  @@index([userId])
}

model ActivityRevision {
  id               String   @id @default(uuid())
  activityId       String
  revisionNo       Int
  title            String   @db.VarChar(150)
  description      String   @db.VarChar(10000)
  targetOrgUnitIds String[]
  changedById      String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedBy User     @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([activityId, revisionNo])
  @@index([activityId, createdAt])
}

model ActivityTargetDept {
  activityId String
  orgUnitId  String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orgUnit  OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([activityId, orgUnitId])
  @@index([orgUnitId, activityId])
}

model Attachment {
  id           String   @id @default(uuid())
  activityId   String
  originalName String   @db.VarChar(255)
  storedName   String   @unique @db.VarChar(255)
  storagePath  String   @db.VarChar(500)
  sizeBytes    Int
  mimeType     String   @db.VarChar(150)
  sha256       String   @db.Char(64)
  uploadedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([activityId])
  @@index([sha256])
}

model CancellationRecord {
  activityId    String   @id
  cancelledById String
  reason        String   @db.VarChar(1000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy User     @relation(fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([cancelledById])
}


enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationCloseType {
  NORMAL
  ADMINISTRATIVE
  CANCELLED_ACTIVITY
}

model Conversation {
  id            String                 @id @default(uuid())
  activityId    String
  askerId       String
  responsibleId String
  status        ConversationStatus     @default(OPEN)
  openedAt      DateTime               @default(now()) @db.Timestamptz(3)
  closedById    String?
  closedAt      DateTime?              @db.Timestamptz(3)
  closeType     ConversationCloseType?
  closeReason   String?                @db.VarChar(500)

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asker       User     @relation("ConversationAsker", fields: [askerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsible User     @relation("ConversationResponsible", fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closedBy    User?    @relation("ConversationCloser", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  messages ConversationMessage[]

  @@index([responsibleId, status])
  @@index([askerId, status])
  @@index([activityId, status])
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  authorId       String
  text           String   @db.VarChar(10000)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([conversationId, createdAt])
}

model ReadReceipt {
  activityId  String
  userId      String
  firstReadAt DateTime @default(now()) @db.Timestamptz(3)
  lastReadAt  DateTime @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([activityId, userId])
  @@index([userId, lastReadAt])
}


model WorkCalendar {
  id              Int   @id @default(1)
  workingDays     Int[]
  workStartMinute Int
  workEndMinute   Int

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model OrgUnitWorkCalendar {
  orgUnitId       String  @id
  workingDays     Int[]
  workStartMinute Int
  workEndMinute   Int
  worksOnHolidays Boolean @default(false)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model Holiday {
  date        DateTime @id @db.Date
  description String   @db.VarChar(150)
}

enum NoActivityPeriodStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoActivityDecisionRoute {
  DIRECT_ENTRY
  DIRECT_MANAGER
  DEPUTY
  UPPER_MANAGER
}

model NoActivityPeriod {
  id         String   @id @default(uuid())
  userId     String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  note       String?  @db.VarChar(500)
  deputyId   String?
  markedById String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  status           NoActivityPeriodStatus @default(APPROVED)
  decidedAt        DateTime?              @db.Timestamptz(3)
  decidedById      String?
  decisionReason   String?                @db.VarChar(500)
  decisionRoute    NoActivityDecisionRoute?

  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledById      String?
  cancellationReason String?   @db.VarChar(500)

  user        User  @relation("NoActivityPeriodUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deputy      User? @relation("NoActivityPeriodDeputy", fields: [deputyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  markedBy    User  @relation("NoActivityPeriodMarker", fields: [markedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy User? @relation("NoActivityPeriodCanceller", fields: [cancelledById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy   User? @relation("NoActivityPeriodDecider", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, startDate, endDate])
  @@index([userId, status, cancelledAt])
  @@index([decidedById, decidedAt])
  @@index([deputyId, cancelledAt])
}

model PushSubscription {
  id        String  @id @default(uuid())
  userId    String
  endpoint  String  @unique @db.VarChar(1000)
  p256dh    String  @db.VarChar(255)
  auth      String  @db.VarChar(255)
  userAgent String? @db.VarChar(300)

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSentAt   DateTime? @db.Timestamptz(3)
  failureCount Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
}

enum FollowUpStatus {
  OPEN
  CLOSED
}

enum FollowUpEventKind {
  OPENED
  CLOSED
  REOPENED
  TRANSFERRED
  UPDATED
  TOUCHED
}

model FollowUpItem {
  id         String         @id @default(uuid())
  activityId String
  status     FollowUpStatus @default(OPEN)

  openedById String
  openedAt   DateTime @default(now()) @db.Timestamptz(3)

  ownerId String

  nextStep   String?   @db.VarChar(500)
  reviewDate DateTime? @db.Date

  lastMovedAt DateTime @default(now()) @db.Timestamptz(3)

  closedById  String?
  closedAt    DateTime? @db.Timestamptz(3)
  closingNote String?   @db.VarChar(1000)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedBy User     @relation("FollowUpOpener", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner    User     @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closedBy User?    @relation("FollowUpCloser", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  events FollowUpItemEvent[]

  @@index([ownerId, status, lastMovedAt])
  @@index([activityId, status])
}

model FollowUpItemEvent {
  id         String            @id @default(uuid())
  followUpId String
  kind       FollowUpEventKind
  actorId    String
  note       String?           @db.VarChar(1000)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  followUp FollowUpItem @relation(fields: [followUpId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor    User         @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([followUpId, createdAt])
}

enum NotificationMode {
  INSTANT
  DAILY_DIGEST
  ACTION_ONLY
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model NotificationQueue {
  id             String              @id @default(uuid())
  userId         String
  eventType      String              @db.VarChar(100)
  activityId     String?
  channel        NotificationChannel
  payload        Json
  idempotencyKey String              @unique @db.VarChar(255)
  status         NotificationStatus  @default(PENDING)
  attemptCount   Int                 @default(0)
  lastAttemptAt  DateTime?           @db.Timestamptz(3)
  sentAt         DateTime?           @db.Timestamptz(3)
  seenAt         DateTime?           @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, lastAttemptAt])
  @@index([userId, createdAt])
  @@index([userId, channel, seenAt])
  @@index([activityId])
}

model ScheduledJobStatus {
  jobName                 String    @id @db.VarChar(100)
  lastSuccessAt           DateTime? @db.Timestamptz(3)
  lastError               String?
  expectedIntervalMinutes Int
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)
}

enum BackupRequestSource {
  MANUAL
  SCHEDULED
}

enum BackupRequestStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model BackupRequest {
  id            String              @id @default(uuid())
  source        BackupRequestSource
  requestedById String?
  status        BackupRequestStatus  @default(PENDING)
  requestedAt   DateTime            @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?           @db.Timestamptz(3)
  finishedAt    DateTime?           @db.Timestamptz(3)
  fileName      String?             @db.VarChar(500)
  sizeBytes     BigInt?
  message       String?             @db.VarChar(1000)

  requestedBy User? @relation("BackupRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, requestedAt])
  @@index([requestedAt])
  @@index([requestedById, requestedAt])
}

enum SystemResetStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model SystemResetRequest {
  id                    String            @id @default(uuid())
  requestedById         String?
  status                SystemResetStatus @default(PENDING)
  requestedAt           DateTime          @default(now()) @db.Timestamptz(3)
  startedAt             DateTime?         @db.Timestamptz(3)
  finishedAt            DateTime?         @db.Timestamptz(3)
  bootstrapFullName     String            @db.VarChar(150)
  bootstrapEmail        String            @db.VarChar(255)
  bootstrapPasswordHash String?           @db.VarChar(255)
  message               String?           @db.VarChar(1000)

  requestedBy User? @relation("SystemResetRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, requestedAt])
  @@index([requestedById, requestedAt])
}

enum DemoObjectOrigin {
  CREATED_BY_INSTALLER
  REUSED_EXISTING
}

model DemoObject {
  objectType String           @db.VarChar(40)
  objectId   String
  origin     DemoObjectOrigin
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@id([objectType, objectId])
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.VarChar(500)
  description String   @db.VarChar(500)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model HelpArticle {
  id          String    @id @default(uuid())
  category    String    @db.VarChar(60)
  title       String    @db.VarChar(200)
  answer      String    @db.Text
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdById String
  updatedById String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)

  createdBy User @relation("HelpArticleCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User @relation("HelpArticleUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([category, archivedAt, isPublished])
  @@index([archivedAt, sortOrder])
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  CRITIQUE
  QUESTION
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

model Feedback {
  id              String           @id @default(uuid())
  submittedById   String
  category        FeedbackCategory
  title           String           @db.VarChar(200)
  description     String           @db.Text
  sourcePath      String?          @db.VarChar(500)
  adminsOnly      Boolean          @default(false)
  status          FeedbackStatus   @default(NEW)
  readAt          DateTime?        @db.Timestamptz(3)
  readById        String?
  reviewedAt      DateTime?        @db.Timestamptz(3)
  reviewedById    String?
  resolvedAt      DateTime?        @db.Timestamptz(3)
  resolvedById    String?
  response        String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?        @db.Timestamptz(3)

  submittedBy User  @relation("FeedbackSubmitter", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  readBy      User? @relation("FeedbackReader", fields: [readById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy  User? @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy  User? @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, archivedAt, createdAt])
  @@index([submittedById, archivedAt, createdAt])
  @@index([readAt, status])
}

model UserScorePeriod {
  userId          String
  periodStart     DateTime @db.Date
  revisionNo      Int      @default(1)
  revisionReason  String   @default("INITIAL") @db.VarChar(60)
  sourceRequestId String?  @unique
  voided          Boolean  @default(false)

  regularity Int
  acceptance Int?
  approval   Int?
  followUp   Int
  total      Int

  expectedDays Int
  writtenDays  Int

  frozen Boolean @default(false)

  profile String? @db.VarChar(20)

  weightRegularity Int?
  weightAcceptance Int?
  weightApproval   Int?
  weightFollowUp   Int?

  appreciationPointsPer Int @default(0)

  formulaVersion Int?

  computedAt DateTime @default(now()) @db.Timestamptz(3)

  user  User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  facts UserScorePeriodFact[]

  @@id([userId, periodStart, revisionNo])
  @@index([periodStart, revisionNo])
  @@index([userId, periodStart, frozen, revisionNo])
}

model UserScorePeriodFact {
  id          String   @id @default(uuid())
  userId      String
  periodStart DateTime @db.Date
  revisionNo  Int      @default(1)

  activityId String
  kind       ScoreFactKind
  happenedOn DateTime      @db.Date
  onTime     Boolean       @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  period   UserScorePeriod @relation(fields: [userId, periodStart, revisionNo], references: [userId, periodStart, revisionNo], onDelete: Restrict, onUpdate: Restrict)
  activity Activity        @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, periodStart, revisionNo])
  @@index([activityId])
}

model ScoreRecalculationRequest {
  id          String    @id @default(uuid())
  userId      String
  periodStart DateTime  @db.Date
  sourceType  String    @db.VarChar(60)
  sourceId    String    @db.VarChar(150)
  requestedAt DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?

  @@unique([userId, periodStart, sourceType, sourceId])
  @@index([processedAt, requestedAt])
  @@index([userId, periodStart, processedAt])
}

model ScoreHistoryControl {
  id            Int      @id @default(1)
  historyStart  DateTime @db.Date
  initializedAt DateTime @default(now()) @db.Timestamptz(3)
}

model ScorePeriodLedger {
  periodStart     DateTime @id @db.Date
  closedAt        DateTime @db.Timestamptz(3)
  retroactiveDays Int
  formulaVersion  Int
}

model ScoreUserStateEvent {
  id               String   @id @default(uuid())
  userId           String
  effectiveAt      DateTime @db.Timestamptz(3)
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)
  isActive         Boolean
  isScored         Boolean
  writesActivities Boolean
  isUnitManager    Boolean
  orgUnitId        String
  reason           String   @db.VarChar(500)
  actorId          String?

  @@index([userId, effectiveAt, recordedAt])
  @@index([orgUnitId, effectiveAt])
}

model ScoreOrgUnitStateEvent {
  id               String   @id @default(uuid())
  orgUnitId        String
  effectiveAt      DateTime @db.Timestamptz(3)
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)
  parentId         String?
  isActive         Boolean
  requiresApproval Boolean
  reason           String   @db.VarChar(500)
  actorId          String?

  @@index([orgUnitId, effectiveAt, recordedAt])
}

model ScoreCompanyCalendarEvent {
  id              String   @id @default(uuid())
  effectiveAt     DateTime @db.Timestamptz(3)
  recordedAt      DateTime @default(now()) @db.Timestamptz(3)
  workingDays     Int[]
  workStartMinute Int
  workEndMinute   Int
  reason          String   @db.VarChar(500)
  actorId         String?

  @@index([effectiveAt, recordedAt])
}

model ScoreUnitCalendarEvent {
  id              String   @id @default(uuid())
  orgUnitId       String
  effectiveAt     DateTime @db.Timestamptz(3)
  recordedAt      DateTime @default(now()) @db.Timestamptz(3)
  hasOwnCalendar  Boolean
  workingDays     Int[]
  workStartMinute Int
  workEndMinute   Int
  worksOnHolidays Boolean
  reason          String   @db.VarChar(500)
  actorId         String?

  @@index([orgUnitId, effectiveAt, recordedAt])
}

model ScoreHolidayEvent {
  id          String   @id @default(uuid())
  holidayDate DateTime @db.Date
  effectiveAt DateTime @db.Timestamptz(3)
  recordedAt  DateTime @default(now()) @db.Timestamptz(3)
  isHoliday   Boolean
  description String?  @db.VarChar(150)
  reason      String   @db.VarChar(500)
  actorId     String?

  @@index([holidayDate, effectiveAt, recordedAt])
}

model ScoreSettingEvent {
  id          String   @id @default(uuid())
  key         String   @db.VarChar(100)
  value       String   @db.VarChar(500)
  effectiveAt DateTime @db.Timestamptz(3)
  recordedAt  DateTime @default(now()) @db.Timestamptz(3)
  reason      String   @db.VarChar(500)
  actorId     String?

  @@index([key, effectiveAt, recordedAt])
}

enum ScoreFactKind {
  WRITTEN
  ACCEPTED
  DECISION
  OBLIGATION
  APPRECIATION
}

model ActivityAppreciation {
  activityId String
  userId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([activityId, userId])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  actualUserId String?
  objectType   String   @db.VarChar(100)
  objectId     String   @db.VarChar(100)
  action       String   @db.VarChar(100)
  detail       Json?
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user       User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actualUser User? @relation("AuditLogActualUser", fields: [actualUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([objectType, objectId, createdAt])
  @@index([userId, createdAt])
}

model ActivityDeletionRequest {
  id         String @id @default(uuid())
  activityId String

  activityTitle  String   @db.VarChar(300)
  activityDate   DateTime @db.Date
  activityAuthor String   @db.VarChar(200)

  requestedById String
  codeHash      String   @db.VarChar(64)
  expiresAt     DateTime @db.Timestamptz(3)
  attemptCount  Int      @default(0)
  consumedAt    DateTime? @db.Timestamptz(3)
  cancelledAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  requestedBy User @relation("DeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestedById, createdAt])
  @@index([activityId])
}
