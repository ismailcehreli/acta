# Copy this file to `.env` and fill in values for your environment.
# `.env` is not committed.
#
# If PostgreSQL is already running on this machine, move POSTGRES_PORT /
# TEST_POSTGRES_PORT to free ports and update the connection URLs accordingly.
#
# Compose services bind only to 127.0.0.1; public exposure must go through a
# reverse proxy over HTTPS (§15.5). Passwords have no defaults.

# --- Application database ----------------------------------------------------
# Connection URL used for local development outside Compose:
DATABASE_URL="postgresql://faaliyet:CHANGE_ME@localhost:5442/faaliyet"

POSTGRES_USER=faaliyet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=faaliyet
POSTGRES_PORT=5442

APP_PORT=3000

# --- Test databases (the Compose test-postgres service, "test" profile) -----
# Vitest connects here; all tables are emptied before each test.
TEST_DATABASE_URL="postgresql://faaliyet_test:faaliyet_test@localhost:5433/faaliyet_test"

# Playwright connects here; end-to-end setup writes only to this database.
# It must not be the application database; the test suite rejects that.
E2E_DATABASE_URL="postgresql://faaliyet_test:faaliyet_test@localhost:5433/faaliyet_e2e"

TEST_POSTGRES_USER=faaliyet_test
TEST_POSTGRES_PASSWORD=faaliyet_test
TEST_POSTGRES_DB=faaliyet_test
TEST_POSTGRES_PORT=5433

# --- Application signing secret ---------------------------------------------
# Read tickets (§10.2) and future password-reset tokens are signed with this.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
APP_SECRET=CHANGE_ME-at-least-32-characters-of-random-data

# --- Email delivery (§12.3) --------------------------------------------------
# If SMTP_HOST or SMTP_FROM is empty, email is NOT SENT; the worker logs this
# on every delivery attempt. The queue continues to run.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Activity Reporting <activity@example.test>"

# Root URL for links in emails.
APP_BASE_URL=http://localhost:3000

# --- Backups (§15.6) ---------------------------------------------------------
# Backups are encrypted with this passphrase. If it is lost, backups cannot be
# opened; store it in the company's password manager. The backup script refuses
# to run when it is not set.
BACKUP_PASSPHRASE=CHANGE_ME-long-and-random-passphrase
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Background worker -------------------------------------------------------
WORKER_TICK_INTERVAL_MS=60000
