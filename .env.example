# Bu dosyayı `.env` olarak kopyalayın ve değerleri ortamınıza göre doldurun.
# `.env` depoya girmez.
#
# Makinede zaten bir PostgreSQL çalışıyorsa POSTGRES_PORT / TEST_POSTGRES_PORT
# değerlerini boştaki bir porta alın ve bağlantı adreslerini de aynı porta çevirin.
#
# Compose servisleri yalnızca 127.0.0.1'e bağlanır; dışarıya açılış ters vekil
# üzerinden yapılacaktır (§15.5). Parolaların varsayılanı yoktur.

# --- Uygulama veritabanı -----------------------------------------------------
# Compose dışında, yerel geliştirmede kullanılan adres:
DATABASE_URL="postgresql://faaliyet:DEGISTIRIN@localhost:5442/faaliyet"

POSTGRES_USER=faaliyet
POSTGRES_PASSWORD=DEGISTIRIN
POSTGRES_DB=faaliyet
POSTGRES_PORT=5442

APP_PORT=3000

# --- Test veritabanları (Compose'daki test-postgres, "test" profili) ---------
# Vitest bu adrese koşar; her testten önce tablolar boşaltılır.
TEST_DATABASE_URL="postgresql://faaliyet_test:faaliyet_test@localhost:5433/faaliyet_test"

# Playwright bu adrese koşar; uçtan uca kurulum yalnızca buraya yazar.
# Uygulama veritabanı ile aynı olamaz — testler bunu reddeder.
E2E_DATABASE_URL="postgresql://faaliyet_test:faaliyet_test@localhost:5433/faaliyet_e2e"

TEST_POSTGRES_USER=faaliyet_test
TEST_POSTGRES_PASSWORD=faaliyet_test
TEST_POSTGRES_DB=faaliyet_test
TEST_POSTGRES_PORT=5433

# --- Uygulama imzalama anahtarı ---------------------------------------------
# Okuma bileti (§10.2) ve ileride parola sıfırlama belirteci bununla imzalanır.
# En az 32 karakter olmalı. Üretin: openssl rand -base64 48
APP_SECRET=DEGISTIRIN-en-az-32-karakterlik-rastgele-bir-deger

# --- E-posta gönderimi (§12.3) -----------------------------------------------
# SMTP_HOST ve SMTP_FROM dolu değilse posta GÖNDERİLMEZ; işleyici bunu her
# gönderim denemesinde günlüğe yazar. Kuyruk yine çalışır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Faaliyet Raporlama <faaliyet@ornek.test>"

# E-postalardaki bağlantıların kökü.
APP_BASE_URL=http://localhost:3000

# --- Yedekleme (§15.6) -------------------------------------------------------
# Yedekler bu parolayla şifrelenir. Parola kaybolursa yedekler açılamaz;
# şirketin parola kasasında saklayın. Tanımlı değilse yedek betiği çalışmaz.
BACKUP_PASSPHRASE=DEGISTIRIN-uzun-ve-rastgele-bir-parola
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Arka plan işleyici ------------------------------------------------------
WORKER_TICK_INTERVAL_MS=60000
